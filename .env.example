DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional: PostgreSQL. Without this, local SQLite is used.
# DATABASE_URL=postgresql://sofra:password@localhost:5432/sofra
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_TRUST_PROXY_TLS=0  # Set to 1 only behind a trusted TLS reverse proxy.
# Production password reset email (SMTP):
# DJANGO_DEFAULT_FROM_EMAIL=Sofra <no-reply@yourdomain.example>
# DJANGO_EMAIL_HOST=smtp.your-provider.example
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=1
