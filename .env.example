DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
SITE_URL=https://servezaflow.com
# Optional verified public identity details.
# SERVEZA_PUBLIC_EMAIL=
# SERVEZA_LEGAL_NAME=
# SERVEZA_SOCIAL_URLS=https://www.instagram.com/serveza2026/,https://www.facebook.com/profile.php?id=61596269777742&open_field=website&sk=directory_links
# SERVEZA_ALLOW_CCBOT=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# A PostgreSQL DATABASE_URL takes precedence. Leave it unset for SQLite.
# DATABASE_URL=postgresql://sofra:password@localhost:5432/sofra
# Set DJANGO_ALLOW_SQLITE=1 to use the existing db.sqlite3 with DJANGO_DEBUG=0.
# DJANGO_ALLOW_SQLITE=0
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_TRUST_PROXY_TLS=0  # Set to 1 only behind a trusted TLS reverse proxy.
# DJANGO_USE_X_FORWARDED_HOST=0  # Enable if that proxy overwrites X-Forwarded-Host.
# Trust client-IP headers only from these proxy networks; empty means no trust.
DJANGO_TRUSTED_PROXY_NETWORKS=
# Only for a protected Unix socket with a trusted proxy overwriting X-Real-IP.
DJANGO_TRUST_UNIX_PROXY_IP=0
# DJANGO_SECURE_HSTS_SECONDS=300
# Gmail SMTP for verification, password resets and staff invitations.
DJANGO_EMAIL_BACKEND=smtp
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
# Optional verified sender. Defaults to the SMTP account above.
DJANGO_DEFAULT_FROM_EMAIL=
